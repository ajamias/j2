# Credentials for whichever provider you pass to --provider.
# Only the one you use needs to be set.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- openrouter ---
# Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# --- ollama (no key; the server must be running) ---
# Defaults to http://localhost:11434
OLLAMA_BASE_URL=

# --- model overrides ---
# Per provider and size, used when no --model / --<size>-model flag is given.
# J2_<PROVIDER>_<SIZE>_MODEL, e.g.:
# J2_OLLAMA_MEDIUM_MODEL=qwen3.5:14b
# J2_OPENROUTER_LARGE_MODEL=anthropic/claude-opus-5.5

# --- j2 itself ---
# debug | info | warn | error | silent (default info). --verbose is shorthand for debug.
J2_LOG_LEVEL=
# Where generated workflows live. Defaults to $XDG_CONFIG_HOME/j2 or ~/.config/j2.
J2_CONFIG_DIR=
# Path to a JSON fixture file; makes `generate` read every model result from disk
# instead of calling a provider. See tests/fixtures/.
J2_FAKE_MODEL=
