# Agent provider: anthropic | openai | ollama | openrouter
AGENT_PROVIDER=anthropic

# Optional model override (provider-specific; leave blank for the provider default)
AGENT_MODEL=

# --- anthropic provider (Claude Agent SDK) ---
# Permission mode: default | acceptEdits | plan | bypassPermissions
AGENT_PERMISSION_MODE=acceptEdits

# --- openai provider (OpenAI Agents SDK) ---
# Required when AGENT_PROVIDER=openai
OPENAI_API_KEY=
# Optional model for the openai provider (defaults to gpt-5.5)
OPENAI_MODEL=

# --- ollama provider (local, OpenAI-compatible API) ---
# Ollama server URL (defaults to http://localhost:11434)
OLLAMA_HOST=
# Model to use; must be tool-capable (defaults to llama3.1)
OLLAMA_MODEL=

# --- openrouter provider (hosted, OpenAI-compatible API) ---
# Required when AGENT_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Model id, namespaced vendor/model; must support tool calling (defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=
# Optional endpoint override (defaults to https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=
