{
  "name": "skills-agent",
  "version": "0.1.0",
  "description": "J2 agent skill orchestration framework, importing skills defined by addyosmani/agent-skills",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "j2": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.16",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.13",
    "@langchain/openrouter": "^0.4.13",
    "@openai/agents": "^0.4.15",
    "@openrouter/agent": "^0.1.0",
    "commander": "^15.0.0",
    "langchain": "^1.5.12",
    "typescript": "^5.5.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0"
  }
}
